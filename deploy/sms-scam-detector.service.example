# systemd USER unit for the SMS Scam Detector API (FastAPI + Uvicorn, no Docker).
# Runs as the deploy user, no sudo needed. Requires lingering for that user
# (`loginctl enable-linger <user>`, done once by an admin) so it starts at boot.
#
# Replace <APP_DIR> with the absolute path of the git checkout,
# e.g. /home/<user>/sms-scam-detector, then install as the deploy user:
#
#   mkdir -p ~/.config/systemd/user
#   cp deploy/sms-scam-detector.service.example ~/.config/systemd/user/sms-scam-detector.service
#   nano ~/.config/systemd/user/sms-scam-detector.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now sms-scam-detector
#   journalctl --user -u sms-scam-detector -f
#
# If `systemctl --user` says "Failed to connect to bus" (e.g. after `su`/sudo
# into the user), run first:  export XDG_RUNTIME_DIR=/run/user/$(id -u)
#
# Optional system-level unit instead (needs root): copy to
# /etc/systemd/system/, add `User=<user>` and `Group=<user>` under [Service],
# and change WantedBy to multi-user.target.

[Unit]
Description=SMS Scam Detector API (FastAPI/Uvicorn)

[Service]
Type=simple
WorkingDirectory=<APP_DIR>
Environment=PYTHONUNBUFFERED=1

# ViSoBERT + PhoBERT (not in git) come from their public Hugging Face repos -- no token
# needed. The commit of each repo is pinned in scam_detector/config.py (*_REVISION).
# First start downloads ~930MB into HF_HOME (default ~/.cache/huggingface), then
# reuses the cache. Remove these lines to use <APP_DIR>/models/visobert/ and
# <APP_DIR>/models/phobert_base_v2/ instead (or let config.py pick the HF repos).

Environment=VISOBERT_SOURCE=dohaduyphong/visobert-scam-sms-vn
Environment=PHOBERT_SOURCE=dohaduyphong/phobert-scam-sms-vn
#Environment=HF_HOME=<APP_DIR>/.cache/huggingface

# Bound to localhost only -- public traffic comes through Nginx/xCloud.
# One worker: each worker would load its own copy of both transformers (~2.5GB RAM).
ExecStart=<APP_DIR>/.venv/bin/uvicorn api:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1

Restart=on-failure
RestartSec=5
TimeoutStartSec=600

NoNewPrivileges=true

[Install]
WantedBy=default.target
