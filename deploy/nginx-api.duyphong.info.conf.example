# Chỉ để tham khảo: reverse proxy từ https://api.duyphong.info tới Uvicorn.
#
# xCloud quản lý cấu hình nginx và chứng chỉ SSL của site này. Không ghi đè
# file của xCloud bằng file này; nếu cần, chỉ chép khối `location /` vào
# phần cấu hình nginx tùy chỉnh của site trong xCloud.
# Trên máy chủ Ubuntu thông thường không có xCloud, có thể dùng nguyên khối server này
# rồi cài SSL riêng (ví dụ certbot --nginx).

server {
    listen 80;
    listen [::]:80;
    server_name api.duyphong.info;

    location / {
        proxy_pass http://127.0.0.1:8000;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Dữ liệu gửi lên nhỏ (api.py giới hạn tin nhắn ở 2000 ký tự).
        client_max_body_size 16k;
        # Request đầu tiên sau khi khởi động lại có thể chậm vì đang nạp model.
        proxy_read_timeout 60s;
    }
}
